\newlabel{tab:results_summary}{{VII}{9}{Analytical KV cache size at \texttt {ctx=256}, \texttt {batch=1} for the FP16 baseline and each optimization technique. Memory reduction is computed against the FP16 baseline}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces Analytical KV cache size (MB) at \texttt  {batch=1} for the simulated techniques as the context length grows. The values come from the smoke-test run reported in \texttt  {coding/results/\_smoke/}.}}{9}{table.8}\protected@file@percent }
\newlabel{tab:scaling}{{VIII}{9}{Analytical KV cache size (MB) at \texttt {batch=1} for the simulated techniques as the context length grows. The values come from the smoke-test run reported in \texttt {coding/results/\_smoke/}}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Behaviour of the techniques across batch sizes and an aggregated summary. \textbf  {Left:} peak KV cache size at \texttt  {context\_length=1024} as the batch grows from 1 to 4; all techniques scale linearly in the batch dimension, preserving their relative ordering. \textbf  {Right:} average tokens per second across all (context, batch) configurations; GQA and PagedAttention lead, the FP16 baseline and the quantized variants form the middle band, and CPU Offloading is at the low end because of the per-token transfer.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:batch_and_summary_tps}{{3}{9}{Behaviour of the techniques across batch sizes and an aggregated summary. \textbf {Left:} peak KV cache size at \texttt {context\_length=1024} as the batch grows from 1 to 4; all techniques scale linearly in the batch dimension, preserving their relative ordering. \textbf {Right:} average tokens per second across all (context, batch) configurations; GQA and PagedAttention lead, the FP16 baseline and the quantized variants form the middle band, and CPU Offloading is at the low end because of the per-token transfer}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Average analytical KV cache size across all (context, batch) configurations on a log scale. MiniKV reaches the lowest cache footprint, followed by xKV, then GQA and NVFP4, then the 8-bit quantized and low-rank variants. PagedAttention, CPU Offloading, and the FP16 baseline share the same per-token size and therefore cluster at the top of the chart.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:summary_kv}{{4}{10}{Average analytical KV cache size across all (context, batch) configurations on a log scale. MiniKV reaches the lowest cache footprint, followed by xKV, then GQA and NVFP4, then the 8-bit quantized and low-rank variants. PagedAttention, CPU Offloading, and the FP16 baseline share the same per-token size and therefore cluster at the top of the chart}{figure.4}{}}
