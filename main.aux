\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Analytical KV cache size at \texttt  {ctx=256}, \texttt  {batch=1} for the FP16 baseline and each optimization technique, computed by \texttt  {analytic\_kv\_mb()} from the model's shape parameters (analytic estimates, not runtime-verified cache measurements). All rows except GQA use \texttt  {sshleifer/tiny-gpt2}, whose cache is only 16 bytes per token (2 layers, 2 KV heads, \texttt  {head\_dim=1}), which is why the values are fractions of a megabyte. GQA uses \texttt  {TinyLlama-1.1B-Chat-v1.0} (22 layers, 4 KV heads, \texttt  {head\_dim=64}); its 5.50\,MB is $8\times $ smaller than a same-shape MHA model (44\,MB), so the reduction is architectural and the value is not comparable with the tiny-gpt2 rows. On both models the Quantized INT8/FP8 and Low-Rank Compression techniques are genuinely executed at runtime (per-projection hooks, or a split of the fused \texttt  {c\_attn} output); see Section~\ref {sec:limitations}.}}{9}{table.7}\protected@file@percent }
\newlabel{tab:results_summary}{{VII}{9}{Analytical KV cache size at \texttt {ctx=256}, \texttt {batch=1} for the FP16 baseline and each optimization technique, computed by \texttt {analytic\_kv\_mb()} from the model's shape parameters (analytic estimates, not runtime-verified cache measurements). All rows except GQA use \texttt {sshleifer/tiny-gpt2}, whose cache is only 16 bytes per token (2 layers, 2 KV heads, \texttt {head\_dim=1}), which is why the values are fractions of a megabyte. GQA uses \texttt {TinyLlama-1.1B-Chat-v1.0} (22 layers, 4 KV heads, \texttt {head\_dim=64}); its 5.50\,MB is $8\times $ smaller than a same-shape MHA model (44\,MB), so the reduction is architectural and the value is not comparable with the tiny-gpt2 rows. On both models the Quantized INT8/FP8 and Low-Rank Compression techniques are genuinely executed at runtime (per-projection hooks, or a split of the fused \texttt {c\_attn} output); see Section~\ref {sec:limitations}}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces Analytical KV cache size (MB) at \texttt  {batch=1} for the simulated techniques as the context length grows, measured by the real sweep reported in \texttt  {coding/results/paper\_sweep/}.}}{9}{table.8}\protected@file@percent }
\newlabel{tab:scaling}{{VIII}{9}{Analytical KV cache size (MB) at \texttt {batch=1} for the simulated techniques as the context length grows, measured by the real sweep reported in \texttt {coding/results/paper\_sweep/}}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Measured behaviour of the seven directly-run techniques as the context length grows at \texttt  {batch=1} (3 trials averaged). \textbf  {Left:} peak GPU memory versus context length. The tiny-gpt2 techniques (FP16 baseline, INT8, FP8, low-rank, PagedAttention, CPU Offloading) stay between 9.8\,MB and 402\,MB; their curves overlap because the tiny-gpt2 KV cache is at most 0.06\,MB while weights and activations dominate, so cache-size differences are invisible at this scale. GQA (TinyLlama-1.1B) is the heaviest (2.1--7.1\,GB) and grows fastest with context. The analytical simulators are omitted from this panel because they allocate no memory (their cache sizes are shown in Figure~\ref {fig:summary_kv}). \textbf  {Centre:} throughput in tokens per second; CPU Offloading (177--285) and PagedAttention (178--221, via its pure-PyTorch CPU fallback, marked with $\times $) lead, followed by the FP16 baseline (149--213), low-rank (151--177), INT8 (135--152), and FP8 (113--126), and GQA is slowest (0.1--6.9) because TinyLlama-1.1B is two orders of magnitude larger than tiny-gpt2. \textbf  {Right:} end-to-end latency on a log scale; GQA's 5--238\,s dominates the axis, while the tiny-gpt2 techniques stay below 0.4\,s.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:context_curves}{{2}{9}{Measured behaviour of the seven directly-run techniques as the context length grows at \texttt {batch=1} (3 trials averaged). \textbf {Left:} peak GPU memory versus context length. The tiny-gpt2 techniques (FP16 baseline, INT8, FP8, low-rank, PagedAttention, CPU Offloading) stay between 9.8\,MB and 402\,MB; their curves overlap because the tiny-gpt2 KV cache is at most 0.06\,MB while weights and activations dominate, so cache-size differences are invisible at this scale. GQA (TinyLlama-1.1B) is the heaviest (2.1--7.1\,GB) and grows fastest with context. The analytical simulators are omitted from this panel because they allocate no memory (their cache sizes are shown in Figure~\ref {fig:summary_kv}). \textbf {Centre:} throughput in tokens per second; CPU Offloading (177--285) and PagedAttention (178--221, via its pure-PyTorch CPU fallback, marked with $\times $) lead, followed by the FP16 baseline (149--213), low-rank (151--177), INT8 (135--152), and FP8 (113--126), and GQA is slowest (0.1--6.9) because TinyLlama-1.1B is two orders of magnitude larger than tiny-gpt2. \textbf {Right:} end-to-end latency on a log scale; GQA's 5--238\,s dominates the axis, while the tiny-gpt2 techniques stay below 0.4\,s}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Measured behaviour of the seven directly-run techniques across batch sizes and an aggregated throughput summary (3 trials averaged). \textbf  {Left:} peak GPU memory at \texttt  {context\_length=512} as the batch grows from 1 to 4; the tiny-gpt2 techniques scale from 15--60\,MB (batch 1) to 29--206\,MB (batch 4), and GQA (TinyLlama-1.1B) from 2.2\,GB to 2.6\,GB. \textbf  {Right:} average tokens per second across all (context, batch) configurations; CPU Offloading (204) and PagedAttention (190, CPU fallback) lead, followed by the FP16 baseline (176), low-rank compression (160), INT8 (135), and FP8 (117); GQA is at the low end (2.8) because it runs the much larger TinyLlama-1.1B.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:batch_and_summary_tps}{{3}{10}{Measured behaviour of the seven directly-run techniques across batch sizes and an aggregated throughput summary (3 trials averaged). \textbf {Left:} peak GPU memory at \texttt {context\_length=512} as the batch grows from 1 to 4; the tiny-gpt2 techniques scale from 15--60\,MB (batch 1) to 29--206\,MB (batch 4), and GQA (TinyLlama-1.1B) from 2.2\,GB to 2.6\,GB. \textbf {Right:} average tokens per second across all (context, batch) configurations; CPU Offloading (204) and PagedAttention (190, CPU fallback) lead, followed by the FP16 baseline (176), low-rank compression (160), INT8 (135), and FP8 (117); GQA is at the low end (2.8) because it runs the much larger TinyLlama-1.1B}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Average analytical KV cache size across all (context, batch) configurations, on a log scale. GQA (TinyLlama-1.1B, 5.5\,MB at \texttt  {ctx=256}) dominates the axis; the tiny-gpt2 techniques cluster between 0.008 and 0.059\,MB on average. Among them, MiniKV reaches the lowest footprint, followed by xKV, then CPU Offloading, NVFP4, and the 8-bit quantized variants, while the FP16 baseline and low-rank (full-rank projectors at \texttt  {head\_dim=1}) sit at the top. The simulated techniques are marked with $\times $ and hatching; PagedAttention's analytic value reflects its block-granular allocation model.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:summary_kv}{{4}{10}{Average analytical KV cache size across all (context, batch) configurations, on a log scale. GQA (TinyLlama-1.1B, 5.5\,MB at \texttt {ctx=256}) dominates the axis; the tiny-gpt2 techniques cluster between 0.008 and 0.059\,MB on average. Among them, MiniKV reaches the lowest footprint, followed by xKV, then CPU Offloading, NVFP4, and the 8-bit quantized variants, while the FP16 baseline and low-rank (full-rank projectors at \texttt {head\_dim=1}) sit at the top. The simulated techniques are marked with $\times $ and hatching; PagedAttention's analytic value reflects its block-granular allocation model}{figure.4}{}}
\citation{chang2025xkv}
\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces Perplexity on a 500-line WikiText-2 subset (\texttt  {wikitext-2-raw-v1} test split) at sequence length 512, \texttt  {batch\_size = 1}, measured on a single NVIDIA GTX 1650 (4~GB). Only the five directly-run techniques are evaluated; NVFP4, MiniKV, and xKV are analytical simulators, and PagedAttention~/~CPU Offloading are lossless (perplexity equals Baseline FP16 by construction). Measured on \texttt  {sshleifer/tiny-gpt2} (harness check; untrained, absolute PPL not meaningful) and \texttt  {TinyLlama/TinyLlama-1.1B-Chat-v1.0}.}}{11}{table.9}\protected@file@percent }
\newlabel{tab:perplexity}{{IX}{11}{Perplexity on a 500-line WikiText-2 subset (\texttt {wikitext-2-raw-v1} test split) at sequence length 512, \texttt {batch\_size = 1}, measured on a single NVIDIA GTX 1650 (4~GB). Only the five directly-run techniques are evaluated; NVFP4, MiniKV, and xKV are analytical simulators, and PagedAttention~/~CPU Offloading are lossless (perplexity equals Baseline FP16 by construction). Measured on \texttt {sshleifer/tiny-gpt2} (harness check; untrained, absolute PPL not meaningful) and \texttt {TinyLlama/TinyLlama-1.1B-Chat-v1.0}}{table.9}{}}
